
# ============================================================
# Snort Rule Loader - Test Rules
# Test: Header, Identification, Content, Packet/TCP, Flow,
#       Classification
# ============================================================


# ------------------------------------------------------------
# 1. Basic TCP alert - any source/destination
# ------------------------------------------------------------
alert tcp any any -> any any (msg:"TEST 001 - Basic TCP"; sid:1000001; rev:1;)


# ------------------------------------------------------------
# 2. UDP with IPv4 addresses and single ports
# ------------------------------------------------------------
alert udp 192.168.1.10 12345 -> 192.168.1.20 53 (msg:"TEST 002 - UDP DNS"; sid:1000002; rev:1;)


# ------------------------------------------------------------
# 3. TCP with CIDR and port range
# ------------------------------------------------------------
alert tcp 192.168.1.0/24 1024:65535 -> 10.10.10.0/24 80:443 (msg:"TEST 003 - CIDR and port range"; sid:1000003; rev:1;)


# ------------------------------------------------------------
# 4. Bidirectional traffic
# ------------------------------------------------------------
alert tcp 10.0.0.1 any <> 10.0.0.2 any (msg:"TEST 004 - Bidirectional"; sid:1000004; rev:1;)


# ------------------------------------------------------------
# 5. Content matching
# ------------------------------------------------------------
alert tcp any any -> any 80 (msg:"TEST 005 - HTTP GET"; content:"GET"; sid:1000005; rev:1;)


# ------------------------------------------------------------
# 6. Content with nocase
# ------------------------------------------------------------
alert tcp any any -> any 80 (msg:"TEST 006 - Case insensitive"; content:"admin"; nocase; sid:1000006; rev:1;)


# ------------------------------------------------------------
# 7. Content with offset and depth
# ------------------------------------------------------------
alert tcp any any -> any 80 (msg:"TEST 007 - Offset and depth"; content:"USER"; offset:10; depth:20; sid:1000007; rev:1;)


# ------------------------------------------------------------
# 8. Content with distance and within
# ------------------------------------------------------------
alert tcp any any -> any 80 (msg:"TEST 008 - Distance and within"; content:"USER"; content:"admin"; distance:0; within:20; sid:1000008; rev:1;)


# ------------------------------------------------------------
# 9. Multiple content keywords
# ------------------------------------------------------------
alert tcp any any -> any 80 (msg:"TEST 009 - Multiple contents"; content:"USER"; content:"admin"; sid:1000009; rev:1;)


# ------------------------------------------------------------
# 10. TCP flags
# ------------------------------------------------------------
alert tcp any any -> any 443 (msg:"TEST 010 - TCP SYN"; flags:S; sid:1000010; rev:1;)


# ------------------------------------------------------------
# 11. Packet size
# ------------------------------------------------------------
alert udp any any -> any 53 (msg:"TEST 011 - DNS packet size"; dsize:0<>512; sid:1000011; rev:1;)


# ------------------------------------------------------------
# 12. Flow to_server
# ------------------------------------------------------------
alert tcp any any -> any 80 (msg:"TEST 012 - To server"; flow:to_server; sid:1000012; rev:1;)


# ------------------------------------------------------------
# 13. Flow to_client
# ------------------------------------------------------------
alert tcp any any -> any 80 (msg:"TEST 013 - To client"; flow:to_client; sid:1000013; rev:1;)


# ------------------------------------------------------------
# 14. Flow established
# ------------------------------------------------------------
alert tcp any any -> any any (msg:"TEST 014 - Established"; flow:established; sid:1000014; rev:1;)


# ------------------------------------------------------------
# 15. Flow not_established
# ------------------------------------------------------------
alert tcp any any -> any any (msg:"TEST 015 - Not established"; flow:not_established; sid:1000015; rev:1;)


# ------------------------------------------------------------
# 16. Classification and priority
# ------------------------------------------------------------
alert tcp any any -> any 22 (msg:"TEST 016 - SSH connection"; classtype:attempted-admin; priority:1; sid:1000016; rev:1;)


# ------------------------------------------------------------
# 17. Combined keywords
# ------------------------------------------------------------
alert tcp 192.168.1.0/24 any -> 10.10.10.10 80 (msg:"TEST 017 - Combined rule"; flow:to_server,established; content:"POST"; nocase; flags:PA; classtype:web-application-activity; priority:2; sid:1000017; rev:1;)


# ------------------------------------------------------------
# 18. Content with offset, depth, and nocase
# ------------------------------------------------------------
alert tcp any any -> any 80 (msg:"TEST 018 - Content modifiers"; content:"password"; nocase; offset:0; depth:50; classtype:attempted-user; priority:2; sid:1000018; rev:1;)


# ------------------------------------------------------------
# 19. TCP port range and bidirectional
# ------------------------------------------------------------
alert tcp 172.16.0.0/16 1000:2000 <> 192.168.1.0/24 80:8080 (msg:"TEST 019 - Bidirectional port ranges"; flow:established; sid:1000019; rev:1;)


# ------------------------------------------------------------
# 20. UDP with classification
# ------------------------------------------------------------
alert udp any any -> any 53 (msg:"TEST 020 - DNS query"; dsize:10<>512; classtype:bad-unknown; priority:3; sid:1000020; rev:1;)


# ------------------------------------------------------------
# 21. Multiple content with distance and within
# ------------------------------------------------------------
alert tcp any any -> any 80 (msg:"TEST 021 - Relative content"; content:"username"; nocase; content:"password"; nocase; distance:1; within:30; sid:1000021; rev:1;)


# ------------------------------------------------------------
# 22. Empty lines and comments test
# ------------------------------------------------------------


# This is a standalone comment.

# Another comment with special characters: !@#$%^&*()


alert tcp any any -> any any (msg:"TEST 022 - After blank lines"; sid:1000022; rev:1;)


# ------------------------------------------------------------
# 23. Final rule
# ------------------------------------------------------------
alert udp 10.0.0.0/8 any -> any 1000:2000 (msg:"TEST 023 - Final UDP rule"; flow:to_server; classtype:policy-violation; priority:2; sid:1000023; rev:1;)
